# Generated by db_ops.sre.create-db-docker - Oracle Database Free single instance
# (gvenzl/oracle-free; 26ai = tag 23.26.2/latest — Oracle kept the 23.26.x numbers).
# Password is supplied via the sibling .env file (DB_PASSWORD); never hardcode it here.
# Data lives in a Docker named volume so the image's oracle user owns it (avoids
# host-uid mismatch). The image sets the SYSTEM/SYS password from ORACLE_PASSWORD and
# serves the FREEPDB1 pluggable database on {{ container_port }}.
services:
  {{ name }}:
    image: {{ image }}
    container_name: {{ name }}
    restart: unless-stopped
    environment:
      ORACLE_PASSWORD: ${DB_PASSWORD}
    ports:
      - "{{ host_port }}:{{ container_port }}"
    volumes:
      - {{ name }}_data:/opt/oracle/oradata
    healthcheck:
      # The image ships its own healthcheck.sh (also declared as the image HEALTHCHECK);
      # declaring it here keeps the probe identical even if the image default changes.
      test: ["CMD-SHELL", "healthcheck.sh"]
      interval: 15s
      timeout: 10s
      retries: 40
      start_period: 120s
volumes:
  {{ name }}_data:

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# db_ops/sre/docker_db/models.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
