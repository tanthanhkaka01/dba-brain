# Generated by db_ops.sre.create-db-docker - Oracle Data Guard lab (1 primary + 1 standby,
# gvenzl/oracle-free, 26ai = tag 23.26.2/latest; Free supports Data Guard since 23ai).
#
# Both containers first come up as ordinary standalone databases; once they are healthy the
# provisioner runs setup/setup_dataguard.sh, which converts the standby into a PHYSICAL
# STANDBY of the primary (RMAN active duplicate) and starts managed recovery. After the
# conversion the standby stays MOUNTED (not OPEN), so the image healthcheck reports it
# "unhealthy" from then on - expected and cosmetic; check it with:
#   docker exec <standby> sqlplus -S / as sysdba   ->  SELECT database_role FROM v$database;
#
# Password is supplied via the sibling .env file (DB_PASSWORD); never hardcode it here.
# Data lives in Docker named volumes so the image's oracle user owns it.
services:
{% for node in nodes %}
  {{ node.service }}:
    image: {{ image }}
    container_name: {{ node.service }}
    hostname: {{ node.service }}
    restart: unless-stopped
    environment:
      ORACLE_PASSWORD: ${DB_PASSWORD}
    ports:
      - "{{ node.host_port }}:{{ container_port }}"
    volumes:
      - {{ node.service }}_data:/opt/oracle/oradata
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh"]
      interval: 15s
      timeout: 10s
      retries: 40
      start_period: 120s
{% endfor %}
  # Oracle Free blocks remote redo transport (ORA-00439), so redo moves the Standard-
  # Edition way: this sidecar forces a log switch and ships/registers new archived logs
  # to the standby every INTERVAL seconds (see ship/ship_loop.sh). RPO ~ INTERVAL.
  {{ name }}-shipper:
    image: docker:cli
    container_name: {{ name }}-shipper
    restart: unless-stopped
    environment:
      PRIMARY: {{ primary_node }}
      STANDBY: {{ standby_node }}
      INTERVAL: "120"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./ship:/ship:ro
    entrypoint: ["sh", "/ship/ship_loop.sh"]
    depends_on:
{% for node in nodes %}
      - {{ node.service }}
{% endfor %}
volumes:
{% for node in nodes %}
  {{ node.service }}_data:
{% endfor %}

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# db_ops/sre/docker_db/models.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
