# Generated by db_ops.sre.create-db-docker - SQL Server single instance.
# Password is supplied via the sibling .env file (DB_PASSWORD); never hardcode it here.
# Data lives in a Docker named volume so the image owns it (avoids host-uid mismatch).
services:
  {{ name }}:
    image: {{ image }}
    container_name: {{ name }}
    restart: unless-stopped
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_SA_PASSWORD: ${DB_PASSWORD}
      MSSQL_PID: Developer
    ports:
      - "{{ host_port }}:{{ container_port }}"
    volumes:
      - {{ name }}_data:/var/opt/mssql
{% for mount in bind_mounts %}      # Same path on both sides on purpose: the restore workflow writes the .bak here over
      # SSH and then hands the ENGINE the same string in RESTORE ... FROM DISK.
      - "{{ mount }}:{{ mount }}"
{% endfor %}    healthcheck:
      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U {{ username }} -P \"$${MSSQL_SA_PASSWORD}\" -Q 'SELECT 1' || /opt/mssql-tools/bin/sqlcmd -S localhost -U {{ username }} -P \"$${MSSQL_SA_PASSWORD}\" -Q 'SELECT 1'"]
      interval: 15s
      timeout: 10s
      retries: 10
volumes:
  {{ name }}_data:

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# db_ops/sre/docker_db/models.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
