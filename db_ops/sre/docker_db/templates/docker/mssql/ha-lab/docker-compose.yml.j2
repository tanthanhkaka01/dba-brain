# Generated by db_ops.sre.create-db-docker - SQL Server Always On availability group (lab).
#
# There is no Windows Failover Cluster or Pacemaker in a container lab, so this is an AG with
# CLUSTER_TYPE = NONE (a "read-scale" AG, SQL Server 2019+ on Linux). What that means, and it
# is not a detail:
#   * NO automatic failover and NO listener. Failover is a manual
#     ALTER AVAILABILITY GROUP ... FAILOVER, and if the primary is gone it needs
#     FORCE_FAILOVER_ALLOW_DATA_LOSS. Clients connect to a replica directly, by port.
#   * It is enough to exercise replication, seeding, AG DMVs and monitoring — not to test
#     automatic HA.
#
# MSSQL_ENABLE_HADR=1 turns on the Always On feature at startup; the AG itself (certificates,
# mirroring endpoints on 5022, the group, the seeded database) is created after the nodes are
# healthy by setup/setup_ag.sh, which the provisioner runs.
#
# Password comes from the sibling .env file (DB_PASSWORD); never hardcode it here.
# Data lives in Docker named volumes so the image owns them (avoids host-uid mismatch).
services:
{% for node in nodes %}
  {{ node.service }}:
    image: {{ image }}
    container_name: {{ node.service }}
    hostname: {{ node.service }}
    restart: unless-stopped
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_SA_PASSWORD: ${DB_PASSWORD}
      MSSQL_PID: Developer
      MSSQL_ENABLE_HADR: "1"
      MSSQL_AGENT_ENABLED: "true"
    ports:
      - "{{ node.host_port }}:{{ container_port }}"
    volumes:
      - {{ node.service }}_data:/var/opt/mssql
      # Backups are READ through a bind mount, never copied in. A container without
      # one forces every restore to `docker cp` the whole set into its volume, which
      # doubles the disk it needs: the Oracle drill's 90 GB backup directory is what
      # made that stop fitting on a 193 GB disk. Read-only - a restore reads backups,
      # and a target that can write to the source's staging area is a target that can
      # destroy the thing it is restoring from.
      - /opt/db_ops/mssql_restore_stage:/var/opt/mssql/restore_stage:ro
    healthcheck:
      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U {{ username }} -P \"$${MSSQL_SA_PASSWORD}\" -Q 'SELECT 1' || /opt/mssql-tools/bin/sqlcmd -S localhost -U {{ username }} -P \"$${MSSQL_SA_PASSWORD}\" -Q 'SELECT 1'"]
      interval: 15s
      timeout: 10s
      retries: 20
{% endfor %}
volumes:
{% for node in nodes %}
  {{ node.service }}_data:
{% endfor %}

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# db_ops/sre/docker_db/models.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
