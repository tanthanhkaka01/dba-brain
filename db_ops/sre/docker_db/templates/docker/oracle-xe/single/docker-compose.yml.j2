# Generated by db_ops.sre.create-db-docker - Oracle Database Express Edition, single instance
# (gvenzl/oracle-xe; tag 11 = 11.2.0.2, the only 11g R2 available as a container image).
#
# XE is a NON-CDB: it serves the service name {{ database }} directly and has no pluggable
# database, so connect to //host:port/{{ database }} — not to FREEPDB1/XEPDB1, which belong to
# the Free and 18c+ XE images respectively.
#
# 11g R2 XE is x86-64 only; Oracle never shipped a Linux 32-bit build of 11.2 XE.
#
# XE licence limits, which are the reason this is a lab engine and not a production one:
# 11 GB of user data, 1 GB of SGA+PGA, and one CPU used for foreground processes.
#
# Password is supplied via the sibling .env file (DB_PASSWORD); never hardcode it here.
# Data lives in a Docker named volume so the image's oracle user owns it (avoids a host-uid
# mismatch). The image sets the SYSTEM/SYS password from ORACLE_PASSWORD.
services:
  {{ name }}:
    image: {{ image }}
    container_name: {{ name }}
    restart: unless-stopped
    environment:
      ORACLE_PASSWORD: ${DB_PASSWORD}
    ports:
      - "{{ host_port }}:{{ container_port }}"
    volumes:
      - {{ name }}_data:/opt/oracle/oradata
{% for mount in bind_mounts %}      # Same path on both sides on purpose: a restore workflow writes the dump here over
      # SSH and then hands the ENGINE the same string.
      - "{{ mount }}:{{ mount }}"
{% endfor %}    healthcheck:
      # The image ships its own healthcheck.sh (also declared as the image HEALTHCHECK);
      # declaring it here keeps the probe identical even if the image default changes.
      test: ["CMD-SHELL", "healthcheck.sh"]
      interval: 15s
      timeout: 10s
      retries: 40
      start_period: 60s
volumes:
  {{ name }}_data:

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# db_ops/sre/docker_db/models.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
