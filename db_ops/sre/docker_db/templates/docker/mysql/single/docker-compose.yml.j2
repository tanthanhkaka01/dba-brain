# Generated by db_ops.sre.create-db-docker - MySQL single instance.
# Password is supplied via the sibling .env file (DB_PASSWORD); never hardcode it here.
# Data lives in a Docker named volume so the image owns it (avoids host-uid mismatch).
services:
  {{ name }}:
    image: {{ image }}
    container_name: {{ name }}
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD}
      MYSQL_DATABASE: {{ database }}
    ports:
      - "{{ host_port }}:{{ container_port }}"
    volumes:
      - {{ name }}_data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u{{ username }} -p$${DB_PASSWORD} --silent"]
      interval: 10s
      timeout: 5s
      retries: 10
volumes:
  {{ name }}_data:

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# db_ops/sre/docker_db/models.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
