# Generated by db_ops.sre.create-db-docker - MySQL HA lab (primary/replica).
#
# WARNING: ha-lab mode is only HA simulation because all containers run on the
# same worker. Worker failure will stop the whole cluster.
#
# Uses bitnami/mysql asynchronous replication: one master, N read replicas. All
# members share the compose network; each is published on its own host port.
# Password comes from the sibling .env file (DB_PASSWORD). Data lives in named
# volumes so the image owns it (avoids host-uid mismatch).
services:
{% for node in primary_nodes %}
  {{ node.service }}:
    image: bitnami/mysql:{{ version }}
    container_name: {{ node.service }}
    restart: unless-stopped
    environment:
      MYSQL_REPLICATION_MODE: master
      MYSQL_REPLICATION_USER: replicator
      MYSQL_REPLICATION_PASSWORD: ${DB_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD}
      MYSQL_DATABASE: {{ database }}
    ports:
      - "{{ node.host_port }}:{{ container_port }}"
    volumes:
      - {{ node.service }}_data:/bitnami/mysql/data
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u{{ username }} -p$${DB_PASSWORD} --silent"]
      interval: 15s
      timeout: 5s
      retries: 10
{% endfor %}
{% for node in standby_nodes %}
  {{ node.service }}:
    image: bitnami/mysql:{{ version }}
    container_name: {{ node.service }}
    restart: unless-stopped
    depends_on:
      - {{ node.primary_host }}
    environment:
      MYSQL_REPLICATION_MODE: slave
      MYSQL_REPLICATION_USER: replicator
      MYSQL_REPLICATION_PASSWORD: ${DB_PASSWORD}
      MYSQL_MASTER_HOST: {{ node.primary_host }}
      MYSQL_MASTER_PORT_NUMBER: {{ container_port }}
      MYSQL_MASTER_ROOT_PASSWORD: ${DB_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD}
    ports:
      - "{{ node.host_port }}:{{ container_port }}"
    volumes:
      - {{ node.service }}_data:/bitnami/mysql/data
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u{{ username }} -p$${DB_PASSWORD} --silent"]
      interval: 15s
      timeout: 5s
      retries: 10
{% endfor %}
volumes:
{% for node in nodes %}
  {{ node.service }}_data:
{% endfor %}

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# db_ops/sre/docker_db/models.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
