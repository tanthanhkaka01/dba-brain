# Generated by db_ops.sre.create-db-docker - PostgreSQL HA lab (streaming replication).
#
# WARNING: ha-lab mode is only HA simulation because all containers run on the
# same worker. Worker failure will stop the whole cluster.
#
# Uses the OFFICIAL postgres:<version> image (works for 16/17/18) with native
# physical streaming replication: one primary + N standbys seeded via
# pg_basebackup. Each node's data is a Docker NAMED VOLUME (a host bind mount
# inherits the host uid and breaks the image's postgres user, uid 999). Password
# comes from the sibling .env file (DB_PASSWORD); the replication role + pg_hba
# rules are provisioned by ./initdb/10-replication.sh on the primary.
services:
{% for node in primary_nodes %}
  {{ node.service }}:
    image: postgres:{{ version }}
    container_name: {{ node.service }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ username }}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: {{ database }}
    command:
      - postgres
      - -c
      - wal_level=replica
      - -c
      - max_wal_senders=10
      - -c
      - max_replication_slots=10
      - -c
      - hot_standby=on
      - -c
      - listen_addresses=*
    ports:
      - "{{ node.host_port }}:{{ container_port }}"
    volumes:
      - {{ node.service }}_data:/var/lib/postgresql
      - ./initdb:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ username }} -d {{ database }}"]
      interval: 10s
      timeout: 5s
      retries: 15
{% endfor %}
{% for node in standby_nodes %}
  {{ node.service }}:
    image: postgres:{{ version }}
    container_name: {{ node.service }}
    restart: unless-stopped
    depends_on:
      {{ node.primary_host }}:
        condition: service_healthy
    environment:
      PGDATA: /var/lib/postgresql/data
      DB_PASSWORD: ${DB_PASSWORD}
      PRIMARY_HOST: {{ node.primary_host }}
    # Runs as root to fix volume ownership, seeds the standby from the primary on
    # first boot with pg_basebackup -R, then drops to the postgres user.
    entrypoint:
      - bash
      - -c
      - |
        set -e
        chown -R postgres:postgres /var/lib/postgresql
        if [ ! -s "$$PGDATA/PG_VERSION" ]; then
          echo "Seeding standby from $$PRIMARY_HOST ..."
          export PGPASSWORD="$$DB_PASSWORD"
          until gosu postgres pg_isready -h "$$PRIMARY_HOST" -U replicator -d {{ database }}; do
            echo "waiting for primary $$PRIMARY_HOST ..."; sleep 2
          done
          # -C -S creates a PERMANENT physical slot and -R writes primary_slot_name, so the
          # primary retains WAL for this standby while it is stopped. Without a slot the
          # primary recycles segments the standby still needs and a standby that was down for
          # a few days can never catch up ("requested WAL segment ... has already been
          # removed") - it has to be re-seeded by hand. A re-seed re-runs this line, so the
          # slot left behind by the previous seed is dropped first; the drop is allowed to
          # fail because on a first seed there is nothing to drop.
          gosu postgres psql -h "$$PRIMARY_HOST" -U replicator -d {{ database }} -Atc \
            "select pg_drop_replication_slot('{{ node.slot_name }}') where exists (select 1 from pg_replication_slots where slot_name = '{{ node.slot_name }}');" || true
          gosu postgres pg_basebackup -h "$$PRIMARY_HOST" -U replicator -D "$$PGDATA" -Fp -Xs -P -R -C -S {{ node.slot_name }}
          printf '%s:%s:*:replicator:%s\n' "$$PRIMARY_HOST" "{{ container_port }}" "$$DB_PASSWORD" > /var/lib/postgresql/.pgpass
          chown postgres:postgres /var/lib/postgresql/.pgpass
          chmod 600 /var/lib/postgresql/.pgpass
        fi
        # PGDATA must be 0700/0750 or postgres refuses to start. pg_basebackup keeps the
        # pre-existing dir mode (postgres 17 ships a /var/lib/postgresql/data that lands in
        # the volume as 0755), so force it every boot.
        chmod 700 "$$PGDATA"
        exec gosu postgres postgres -c hot_standby=on -c listen_addresses=*
    ports:
      - "{{ node.host_port }}:{{ container_port }}"
    volumes:
      - {{ node.service }}_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ username }} -d {{ database }}"]
      interval: 10s
      timeout: 5s
      retries: 15
{% endfor %}
volumes:
{% for node in nodes %}
  {{ node.service }}_data:
{% endfor %}

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# db_ops/sre/docker_db/models.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
