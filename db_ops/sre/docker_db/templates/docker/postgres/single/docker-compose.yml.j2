# Generated by db_ops.sre.create-db-docker - PostgreSQL single instance.
# Password is supplied via the sibling .env file (DB_PASSWORD); never hardcode it here.
#
# Data lives in a Docker NAMED VOLUME (not a host bind mount): a bind mount inherits
# the host directory's uid, which mismatches the image's postgres user (uid 999) and
# breaks catalog reads ("pg_filenode.map: Permission denied"). A named volume lets the
# image own its data correctly. It also mounts the PARENT dir (postgres 18 stores data
# in a major-version subdir and rejects a mount at .../data).
services:
  {{ name }}:
    image: {{ image }}
    container_name: {{ name }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ username }}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: {{ database }}
    ports:
      - "{{ host_port }}:{{ container_port }}"
    volumes:
      - {{ name }}_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ username }} -d {{ database }}"]
      interval: 10s
      timeout: 5s
      retries: 10
volumes:
  {{ name }}_data:

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# db_ops/sre/docker_db/models.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
