    {
      "node_role": "all",
      "app_ord": 2,
      "app_command_id": "APP-METRICS",
      "app_code": "APP-METRICS",
      "app_name": "db_ops_metrics",
      "display_name": "Collect DB metrics",
      "log_scope": "metrics",
      "working_dir": "tools/db_ops",
      "command_text": "python -m db_ops.metrics.cli --config config.json collect",
      "active": true,
      "note": "timeout 2400s, not 600: this is the budget for the whole collection pass, so it has to stay above the slowest metric in it plus the rest of the pass. MAINTENANCE_INDEX_FRAGMENTATION alone is allowed 1800s (data/metric_definitions.json) and the rest of a pass measured ~180s, so 2400 leaves headroom without letting a genuinely hung pass block collection for an hour. At 600 the daemon killed the pass mid-flight, which loses every other metric in it - worse than the one slow metric failing on its own. Keep this number ABOVE the largest metric timeout: equal is not enough, because the metric would still be running when the daemon reaches its own limit. The daemon skips a cycle while a pass is still running (reason=already_running), so on the one weekly night this runs long the 5-minute metrics are delayed inside the 01-06 maintenance window rather than lost.",
      "time_window": {
        "from_year": null,
        "to_year": null,
        "from_month": null,
        "to_month": null,
        "from_day": 1,
        "to_day": 31,
        "from_hour": 0,
        "to_hour": 23,
        "from_minute": null,
        "to_minute": null,
        "repeat_interval": 120,
        "retry_interval": 60,
        "timeout": 2400
      }
    },
