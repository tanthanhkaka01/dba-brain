groups:
  - name: observability-baseline
    rules:
      - alert: PrometheusTargetDown
        expr: up == 0
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "Prometheus target down"
          description: "{% raw %}{{ $labels.job }} target {{ $labels.instance }} is down.{% endraw %}"

      - alert: HostHighCpu
        expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High CPU usage"
          description: "{% raw %}CPU usage on {{ $labels.instance }} has been above 90% for 10 minutes.{% endraw %}"

      - alert: HostLowDiskSpace
        expr: (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"}) * 100 < 15
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Low disk space"
          description: "{% raw %}Filesystem free space on {{ $labels.instance }} is below 15%.{% endraw %}"
