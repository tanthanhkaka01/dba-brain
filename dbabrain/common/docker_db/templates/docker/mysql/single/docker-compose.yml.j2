# Generated by dbabrain.sre.create-db-docker - MySQL single instance.
# Password is supplied via the sibling .env file (DB_PASSWORD); never hardcode it here.
# Data lives in a Docker named volume so the image owns it (avoids host-uid mismatch).
services:
  {{ name }}:
    image: {{ image }}
    container_name: {{ name }}
    restart: unless-stopped
    # PID 1 is Docker's init, not the database (0.37.0): a command dbabrain runs in the container and
    # leaves behind is reaped by it. With postgres as PID 1 such an orphan became postgres's child,
    # and its abnormal end made postgres restart the whole instance (the store drill, 2026-11-10).
    init: true
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD}
      MYSQL_DATABASE: {{ database }}
    ports:
      - "{{ host_port }}:{{ container_port }}"
    volumes:
      - {{ name }}_data:/var/lib/mysql
{% for mount in bind_mounts %}      # Same path on both sides on purpose: a dump written here inside the container sits at the
      # same path on the host, which is what a restore on another machine reads over SSH.
      - "{{ mount }}:{{ mount }}"
{% endfor %}    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u{{ username }} -p$${DB_PASSWORD} --silent"]
      interval: 10s
      timeout: 5s
      retries: 10
volumes:
  {{ name }}_data:

# The compose network is pinned, never left to Docker's default address pool: that pool covers
# 172.17-172.31, ranges this estate routes real databases on, and an auto-allocated lab bridge
# has twice blackholed a production instance from the worker. See
# dbabrain/lib/docker_db_spec.py::lab_network_subnet.
networks:
  default:
    ipam:
      config:
        - subnet: {{ network_subnet }}
