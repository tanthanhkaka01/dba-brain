      "empty_result_is_ok": true,
      "active": true,
      "connection_error_severity": "WARNING",
      "execution_error_severity": "WARNING",
      "time_window": {
        "from_year": null,
        "to_year": null,
        "from_month": null,
        "to_month": null,
        "from_day": null,
        "to_day": null,
