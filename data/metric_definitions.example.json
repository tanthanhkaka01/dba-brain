        "to_hour": null,
        "from_minute": null,
        "to_minute": null,
        "repeat_interval": 150,
        "timeout": 60
      },
      "collector_type": "sql",
      "variants": [
        {
          "db_type": "sqlserver",
          "min_major_version": 0,
          "max_major_version": 10,
          "name": "sqlserver_legacy_2008r2",
          "file": "sqlserver/legacy_2008r2/024_sqlserver_sleeping_open_transaction.sql"
        },
        {
          "db_type": "sqlserver",
          "min_major_version": 11,
          "name": "sqlserver_modern_2012_plus",
          "file": "sqlserver/024_sqlserver_sleeping_open_transaction.sql"
        },
        {
          "db_type": "oracle",
          "name": "oracle_unsupported",
          "supported": false,
          "unsupported_reason": "Sleeping open transaction detection uses SQL Server session and transaction DMVs."
        },
        {
          "db_type": "mysql",
          "name": "mysql_unsupported",
          "supported": false,
          "unsupported_reason": "Sleeping open transaction detection is not implemented for MySQL in this catalog."
        },
        {
          "db_type": "postgresql",
          "name": "postgresql_todo",
          "supported": false,
          "unsupported_reason": "PostgreSQL implementation has not been authored yet."
        }
      ],
      "report_policy": {
        "enabled": true,
        "condition_grouping": {
          "enabled": true,
          "event_code": "LOCK_SLEEPING_OPEN_TRANSACTION",
          "key_fields": [
            "instance_key",
            "database",
            "login",
            "host",
            "program"
          ],
          "aggregate_fields": {
            "count": "count",
            "max_idle_minutes": {
              "op": "max",
              "field": "idle_minutes"
            },
            "sample_spids": {
              "op": "sample",
              "field": "spid",
              "limit": 5
            }
          },
          "replace_raw_rows": true,
          "max_groups": 20
        },
        "severity_policy": {
          "default": "KEEP",
          "note": "These thresholds grade on idle_minutes / is_blocking / has_x_lock, which the Oracle and legacy-2008R2 variants emit on purpose. The modern SQL Server variant emits idle_seconds / blocked_sessions and grades itself in SQL, so these rules match nothing there and editing them will not change SQL Server behaviour - change assets/metrics/sqlserver/024_sqlserver_sleeping_open_transaction.sql instead. Pinned by tests/test_sleeping_open_transaction_grading.py.",
          "by_env": {
            "prod": "KEEP",
            "dev": "DOWNGRADE_TO_WARNING",
            "lab": "DOWNGRADE_TO_LOGGING",
            "sandbox": "DOWNGRADE_TO_LOGGING"
          },
          "thresholds": [
            {
              "field": "idle_minutes",
              "op": "<",
              "value": 30,
              "severity": "SUPPRESS",
              "unless": [
                {
                  "field": "is_blocking",
                  "op": "=",
                  "value": true
                },
                {
                  "field": "has_x_lock",
                  "op": "=",
                  "value": true
                }
              ]
            },
            {
              "field": "idle_minutes",
              "op": ">=",
              "value": 30,
              "severity": "WARNING"
            },
            {
              "field": "idle_minutes",
              "op": ">=",
              "value": 120,
              "severity": "CRITICAL"
            },
            {
              "field": "is_blocking",
              "op": "=",
              "value": true,
              "severity": "CRITICAL"
            },
            {
              "field": "has_x_lock",
              "op": "=",
              "value": true,
              "severity": "CRITICAL"
            }
          ]
        },
        "render_policy": {
          "mode": "compact",
          "fields": [
            "database",
            "login",
            "host",
            "program",
            "count",
            "max_idle_minutes",
            "sample_spids"
          ],
          "max_items": 5,
          "include_raw_message": false
        }
      },
      "max_rows": 500
    },
