            "lab": "DOWNGRADE_TO_LOGGING",
            "sandbox": "DOWNGRADE_TO_LOGGING"
          },
          "thresholds": []
        },
        "render_policy": {
          "mode": "compact",
          "fields": [
            "issue_type",
            "count",
            "sample_databases"
          ],
          "max_items": 3,
          "include_raw_message": false
        }
      },
      "max_rows": 500
    },
