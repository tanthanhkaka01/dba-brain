{
  "notes": [
    "Sample sre_config.json - how lab environments are built: the hypervisor, the templates, the network, and the defaults each engine is installed with. Copy to sre_config.json and edit.",
    "This file describes a LAB, not the monitored estate. It exists so a restore drill, a version upgrade or a failover rehearsal has somewhere disposable to happen; nothing here should ever point at a production machine.",
    "It is the one configuration file that still carries literal passwords, because the values are typed into an installer for a machine that is about to be created and thrown away. Every value below is a placeholder and must be changed. If a lab is ever kept, move its credentials into users.json and the encrypted secret store like everything else.",
    "'automation' paths are where the generated PowerShell, bash and Ansible live. 'inventory.groups' is the planned shape of the lab - name, address and role per machine - and is what the playbooks are rendered against.",
    "'database_defaults' is per engine and per topology. It is the answer to 'what does a new lab cluster of this kind look like', so a rehearsal starts from a known shape instead of whatever the last person typed.",
    "Addresses use the documentation ranges. Give the lab a network of its own; a rehearsal that can reach production is not a rehearsal."
  ],
  "app_name": "db_ops_sre",
  "console_level": "INFO",
  "file_level": "INFO",
  "sre": {
    "vmware": {
      "vmrun_path": "C:/Program Files (x86)/VMware/VMware Workstation/vmrun.exe",
      "vm_root": "D:/VMs",
      "template_name": "tpl-ubuntu-2404",
      "template_snapshot_name": "base-os",
      "net_interface": "ens33",
      "cidr": 24,
      "gateway": "198.51.100.2",
      "dns_servers": [
        "198.51.100.2"
      ]
    },
    "automation": {
      "dir": "../db_ops/sre/automation",
      "powershell_dir": "../db_ops/sre/automation/powershell",
      "bash_dir": "../db_ops/sre/automation/bash",
      "ansible_dir": "../db_ops/sre/automation/ansible"
    },
    "credentials": {
      "_note": "Lab-only. These machines are created from a template, rehearsed on and destroyed, which is why a literal password here is defensible. Prefer the ref form anyway: write \"<name>_password_ref\": \"SOME_STORE_KEY\" and keep the value in the encrypted secret store (db-ops encrypt-secret). A literal, \"<name>_password_env\", and \"<name>_password_ref\" are all read, in that order. A lab that gets kept is how a throwaway password becomes a stored one.",
      "guest_user": "labuser",
      "guest_password_ref": "LAB_GUEST_PASSWORD",
      "root_user": "root",
      "root_password_ref": "LAB_ROOT_PASSWORD",
      "windows_administrator_password_ref": "LAB_WINDOWS_ADMINISTRATOR_PASSWORD",
      "ssh_identity_file": "~/.ssh/db_lab_id_ed25519",
      "plink_path": "C:/Program Files/PuTTY/plink.exe"
    },
    "inventory": {
      "dir": "../db_ops/sre/inventory",
      "groups": {
        "shared": [
          {
            "name": "bastion-01",
            "ip": "198.51.100.3",
            "role": "bastion"
          },
          {
            "name": "mon-01",
            "ip": "198.51.100.4",
            "role": "monitoring"
          }
        ],
        "postgresql": [
          {
            "name": "pg-01",
            "ip": "198.51.100.21",
            "role": "postgresql"
          },
          {
            "name": "pg-02",
            "ip": "198.51.100.22",
            "role": "postgresql"
          },
          {
            "name": "pg-03",
            "ip": "198.51.100.23",
            "role": "postgresql"
          }
        ],
        "sqlserver": [
          {
            "name": "mssql-01",
            "ip": "198.51.100.31",
            "role": "sqlserver"
          },
          {
            "name": "mssql-02",
            "ip": "198.51.100.32",
            "role": "sqlserver"
          }
        ],
        "mysql": [
          {
            "name": "mysql-01",
            "ip": "198.51.100.11",
            "role": "mysql"
          }
        ],
        "oracle_dg": [
          {
            "name": "orapri",
            "ip": "198.51.100.51",
            "role": "oracle_dg"
          },
          {
            "name": "orastb",
            "ip": "198.51.100.52",
            "role": "oracle_dg"
          }
        ]
      }
    },
    "oracle": {
      "version": "19c",
      "rac_template_name": "tpl-oraclelinux-r9",
      "dg_template_name": "tpl-oraclelinux-r9",
      "grid_installer_path": "D:/software/oracle/grid_home.zip",
      "db_installer_path": "D:/software/oracle/db_home.zip",
      "install_stage": "/u01/app/stage"
    },
    "database_defaults": {
      "postgresql": {
        "cluster_name": "postgresql-lab",
        "version": 16,
        "port": 5432,
        "superuser": "postgres",
        "superuser_password_ref": "LAB_POSTGRESQL_SUPERUSER_PASSWORD",
        "replication_user": "replicator",
        "replication_password_ref": "LAB_POSTGRESQL_REPLICATION_PASSWORD"
      },
      "mysql": {
        "cluster_name": "mysql-lab",
        "cluster_admin_user": "clusteradmin",
        "cluster_admin_password_ref": "LAB_MYSQL_CLUSTER_ADMIN_PASSWORD",
        "classic_port": 3306
      },
      "sqlserver": {
        "port": 1433,
        "instance_name": "MSSQLSERVER",
        "sa_user": "sa",
        "sa_password_ref": "LAB_SQLSERVER_SA_PASSWORD",
        "dba_user": "dba_user",
        "dba_password_ref": "LAB_SQLSERVER_DBA_PASSWORD",
        "ha_mode": "always_on_ag",
        "ag_name": "AG-LAB",
        "ag_listener": "mssql-ag-listener",
        "ag_listener_port": 1433
      },
      "oracle_dataguard": {
        "oracle_topology": "dataguard",
        "oracle_version": "19c",
        "port": 1521,
        "service_name": "LABDB",
        "sys_user": "sys",
        "sys_password_ref": "LAB_ORACLE_DATAGUARD_SYS_PASSWORD",
        "dba_user": "dba_user",
        "dba_password_ref": "LAB_ORACLE_DATAGUARD_DBA_PASSWORD",
        "oracle_home": "/u01/app/oracle/product/19.3.0/dbhome_1",
        "oracle_base": "/u01/app/oracle",
        "primary_service": "LABDB_PRIMARY",
        "standby_service": "LABDB_STANDBY",
        "dg_broker_enabled": true,
        "log_transport_mode": "ASYNC",
        "protection_mode": "MAX_PERFORMANCE"
      }
    }
  }
}
