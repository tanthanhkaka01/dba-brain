# Copy to .env beside docker-compose.yml. Docker Compose reads it for ${...} in the compose file.
#
# The image tag this node runs. `latest` follows every release (never a release candidate); a
# version (0.24.0) or a minor (0.24) pins it. To roll back, name the version you kept.
DBABRAIN_TAG=latest
#
# Nothing else belongs here. The passphrase (DB_OPS_SECRET_KEY) comes from the shell that runs
# `docker compose up`, never from this file.
